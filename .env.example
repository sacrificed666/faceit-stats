# A server-side key from https://developers.faceit.com, used only on the server
FACEIT_API_KEY=
# The nicknames of the squad, case-sensitive, separated by commas or spaces
FACEIT_PLAYERS=
# Optional: another FACEIT Data API address, such as the mock API of the tests
FACEIT_API_URL=
# Optional on Vercel: the public address for links, the sitemap and share cards
SITE_URL=
# Docker only: the host port (3000 development and production, 3001 staging)
APP_PORT=
